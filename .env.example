# --- Base de données ---
DATABASE_URL="postgresql://vrboost@localhost:54329/vrboost"
# Base dédiée aux tests d'intégration (vidée à chaque exécution)
TEST_DATABASE_URL="postgresql://vrboost@localhost:54329/vrboost_test"

# --- Application ---
# development | staging | production
APP_ENV="development"
APP_URL="http://localhost:3100"
# Durée de session en heures
SESSION_TTL_HOURS="12"

# --- Actifs privés (cachet, signature, polices) ---
PRIVATE_ASSETS_DIR="./private"
# "lufga" uniquement après confirmation d'une licence Lufga couvrant l'incorporation PDF
# (sinon "helvetica", police standard PDF identique au devis de référence)
PDF_FONT="helvetica"

# --- HubSpot (Private App, côté serveur uniquement) ---
# Scopes : crm.objects.companies.read/write, crm.objects.contacts.read,
#          crm.objects.deals.read, crm.objects.notes.write (via contacts/companies write), files
HUBSPOT_ACCESS_TOKEN=""
# Propriété personnalisée de transaction (optionnelle) pour refléter le statut du devis/facture
HUBSPOT_DEAL_STATUS_PROPERTY=""

# --- Comptes initiaux (seed) ---
SEED_CEO_EMAIL="contact@vrboostagency.com"
SEED_CEO_PASSWORD=""
SEED_SALES_EMAIL="meryem.lasseri@vrboostagency.com"
SEED_SALES_PASSWORD=""
